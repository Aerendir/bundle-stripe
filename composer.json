{
    "name": "serendipity_hq/bundle-stripe",
    "type": "symfony-bundle",
    "description": "A set of utilities to integrate Stripe into Symfony.",
    "keywords": [
        "stripe",
        "bundle",
        "symfony"
    ],
    "homepage": "https://github.com/Aerendir/bundle-stripe",
    "license": "MIT",
    "support": {
        "docs": "https://github.com/Aerendir/bundle-stripe/tree/dev/docs",
        "issues": "https://github.com/Aerendir/bundle-stripe/issues"
    },
    "authors": [
        {
            "name": "Adamo Aerendir Crespi",
            "email": "hello@aerendir.me"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "doctrine/orm": "^2.20 || ^3.0",
        "serendipity_hq/component-value-objects": "^7.1.1",
        "stripe/stripe-php": "^7.52 || ^8.0 || ^9.0 || ^10.0",
        "symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "ext-ast": "*",
        "bamarni/composer-bin-plugin": "^1.4",
        "doctrine/common": "^2.8 || ^3.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "monolog/monolog": "^2.0 || ^3.0",
        "phpdocumentor/reflection-docblock": "^5.2",
        "phpstan/phpstan": "2.3.5",
        "phpstan/phpstan-doctrine": "2.1.2",
        "phpstan/phpstan-phpunit": "2.1.2",
        "phpstan/phpstan-symfony": "2.1.1",
        "rector/rector": "2.8.5",
        "roave/security-advisories": "dev-master",
        "serendipity_hq/component-var-dumper-f": "^2.1.5",
        "serendipity_hq/rector-config": "1.1.20",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.0",
        "symfony/form": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\StripeBundle\\Dev\\": "dev",
            "SerendipityHQ\\Bundle\\StripeBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\StripeBundle\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "scripts": {
        "bin": "echo 'bin not installed'",
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false
        }
    }
}
